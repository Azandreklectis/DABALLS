# Copy the required settings into your shell environment before launch.
# Generate a strong random token for any controller reachable by other machines.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(32))"
DABALLS_API_TOKEN=
DABALLS_DATABASE_PATH=~/.daballs/controller.sqlite3
DABALLS_ARTIFACT_DIR=~/.daballs/artifacts
DABALLS_JOB_RUNTIME_DIR=~/.daballs/job-runtime
